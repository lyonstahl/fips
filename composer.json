{
    "type": "library",
    "license": "Apache-2.0",
    "name": "lyonstahl/fips",
    "description": "Offline Census FIPS lookups for U.S. states, counties, and county equivalents.",
    "homepage": "https://github.com/lyonstahl/fips",
    "keywords": [
        "federal information processing standard",
        "fips",
        "county",
        "state",
        "census",
        "usa",
        "united states"
    ],
    "require": {
        "ext-ctype": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "php": ">=7.3"
    },
    "require-dev": {
        "ext-zip": "*",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "LyonStahl\\Fips\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LyonStahl\\Fips\\Tools\\": "tools/src",
            "Tests\\": "tests"
        }
    },
    "archive": {
        "exclude": [
            "/.github",
            "/.phpunit.result.cache",
            "/composer.lock",
            "/phpcs.xml.dist",
            "/phpstan.neon.dist",
            "/phpunit.xml",
            "/tests",
            "/tools",
            "/vendor"
        ]
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress",
        "check": [
            "@style",
            "@analyse",
            "@test"
        ],
        "style": "phpcs",
        "style:fix": "phpcbf",
        "test": [
            "phpunit"
        ]
    },
    "support": {
        "issues": "https://github.com/lyonstahl/fips/issues",
        "source": "https://github.com/lyonstahl/fips"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
